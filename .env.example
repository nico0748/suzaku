# Suzaku environment variables (copy to .env and fill in)
# NEVER commit .env

# GitHub API (Sentinel / Herald)
SUZAKU_GITHUB_TOKEN=

# Notion API (Sentinel sync / Chronicle sync)
SUZAKU_NOTION_TOKEN=
SUZAKU_NOTION_TARGETS_DB_ID=
SUZAKU_NOTION_DISCLOSURE_DB_ID=

# Local data paths
SUZAKU_DATA_DIR=./.suzaku
SUZAKU_EVIDENCE_DIR=./evidence
SUZAKU_POCS_DIR=./pocs

# Log level: DEBUG / INFO / WARNING / ERROR
SUZAKU_LOG_LEVEL=INFO
